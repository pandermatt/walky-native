/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The worker is how a new build reaches anyone who already has the old one, so
# it has to be revalidated rather than served from an intermediate cache.
/sw.js
  Cache-Control: no-cache

# Both shells. The bundle they pull in is content-hashed and immutable above;
# the HTML that names it is the one file that must never be served stale, or a
# deploy reaches nobody who has been here before.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/demo
  Cache-Control: no-cache

/demo/
  Cache-Control: no-cache

/demo/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# The font's name carries no content hash, but it is a font: it changes when the
# family is replaced, not when the app is rebuilt.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800
